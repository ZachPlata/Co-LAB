    <Compile Update="UCAdmin\uc_SkillCategories.cs">
      <SubType>UserControl</SubType>
    </Compile>
    <Compile Update="UCAdmin\uc_SkillCategories.Designer.cs">
      <DependentUpon>uc_SkillCategories.cs</DependentUpon>
    </Compile>
    <EmbeddedResource Update="UCAdmin\uc_SkillCategories.resx">
      <DependentUpon>uc_SkillCategories.cs</DependentUpon>
    </EmbeddedResource>

    <Compile Update="UCAdmin\uc_ModerateListings.cs">
      <SubType>UserControl</SubType>
    </Compile>
    <Compile Update="UCAdmin\uc_ModerateListings.Designer.cs">
      <DependentUpon>uc_ModerateListings.cs</DependentUpon>
    </Compile>
    <EmbeddedResource Update="UCAdmin\uc_ModerateListings.resx">
      <DependentUpon>uc_ModerateListings.cs</DependentUpon>
    </EmbeddedResource>

    <Compile Update="UCAdmin\uc_ReportedStudents.cs">
      <SubType>UserControl</SubType>
    </Compile>
    <Compile Update="UCAdmin\uc_ReportedStudents.Designer.cs">
