<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RootNamespace>Co_LAB</RootNamespace>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <!-- Forms -->
    <Compile Update="StudentMainForm.cs">
      <SubType>Form</SubType>
    </Compile>
    <Compile Update="StudentMainForm.Designer.cs">
      <DependentUpon>StudentMainForm.cs</DependentUpon>
    </Compile>
    <EmbeddedResource Update="StudentMainForm.resx">
      <DependentUpon>StudentMainForm.cs</DependentUpon>
    </EmbeddedResource>

    <Compile Update="AdminMainForm.cs">
      <SubType>Form</SubType>
    </Compile>
    <Compile Update="AdminMainForm.Designer.cs">
      <DependentUpon>AdminMainForm.cs</DependentUpon>
    </Compile>
    <EmbeddedResource Update="AdminMainForm.resx">
      <DependentUpon>AdminMainForm.cs</DependentUpon>
    </EmbeddedResource>

    <!-- Student UserControls -->
    <Compile Update="UCStudents\uc_StudentDashboard.cs">
      <SubType>UserControl</SubType>
    </Compile>
    <Compile Update="UCStudents\uc_StudentDashboard.Designer.cs">
      <DependentUpon>uc_StudentDashboard.cs</DependentUpon>
    </Compile>
    <EmbeddedResource Update="UCStudents\uc_StudentDashboard.resx">
      <DependentUpon>uc_StudentDashboard.cs</DependentUpon>
    </EmbeddedResource>

    <Compile Update="UCStudents\uc_PostSkill.cs">
      <SubType>UserControl</SubType>
    </Compile>
    <Compile Update="UCStudents\uc_PostSkill.Designer.cs">
