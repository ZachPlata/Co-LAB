    </Compile>
    <EmbeddedResource Update="UCStudents\uc_PostSkill.resx">
      <DependentUpon>uc_PostSkill.cs</DependentUpon>
    </EmbeddedResource>

    <Compile Update="UCStudents\uc_ManageSkills.cs">
      <SubType>UserControl</SubType>
    </Compile>
    <Compile Update="UCStudents\uc_ManageSkills.Designer.cs">
      <DependentUpon>uc_ManageSkills.cs</DependentUpon>
    </Compile>
    <EmbeddedResource Update="UCStudents\uc_ManageSkills.resx">
      <DependentUpon>uc_ManageSkills.cs</DependentUpon>
    </EmbeddedResource>

    <Compile Update="UCStudents\uc_TradeRequests.cs">
      <SubType>UserControl</SubType>
    </Compile>
    <Compile Update="UCStudents\uc_TradeRequests.Designer.cs">
      <DependentUpon>uc_TradeRequests.cs</DependentUpon>
    </Compile>
    <EmbeddedResource Update="UCStudents\uc_TradeRequests.resx">
